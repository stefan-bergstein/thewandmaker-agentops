# Copy to .env and fill in. NAME=value, one per line, no quotes, no spaces around "=".
# Never commit .env. "make preflight" tells you which names are missing, without printing values.

# --- Existing OpenShift cluster -------------------------------------------------------------
# Log in with oc first. All commands honor the exported KUBECONFIG or ~/.kube/config.
# ROSA, AWS and a bastion are NOT required. Install the OpenShell CLI on this machine.
# Optional remote execution instead of the local CLI: set BOTH values, or leave both empty.
BASTION_HOST=
BASTION_USER=
# Optional ROSA provisioning/access helpers only (make up-access / rosa-cluster-login).
ROSA_API_URL=

# --- Required: the main model (any OpenAI-compatible chat completions endpoint) ------------
# We used Red Hat's internal Models-as-a-Service. The guardrails and the OpenShell provider call it.
# Model name as the endpoint knows it
model=
# Full URL, ending in /v1 or /v1/chat/completions
modelendpoint=
# API key for that endpoint
modelkey=

# --- Optional: backup oracles behind the model gateway --------------------------------------
# OpenRouter (paid, a few US cents per rehearsal). With ORACLE_MODE=backup-first, the default in
# gitops/20-shop/install.sh, this one answers first and the main model is the fallback.
OPENROUTER_API_KEY=
# A second OpenAI-compatible endpoint, asked when OpenRouter can't answer. Leave empty to switch off.
REDHATTMM_BASE_URL=
REDHATTMM_MODEL=
REDHATTMM_API_KEY=

# --- Optional: the hosted deck --------------------------------------------------------------
# One password that lets a browser into the live deck on the cluster. It goes into the secret
# deck-login (gitops/20-shop/install.sh). Without it the hosted deck has no password door.
DECK_PASSWORD=

# --- Only for "make up" (your own ROSA HCP cluster with Terraform) --------------------------
# Skip these when the cluster already exists. Also copy infra/context.example.json to
# infra/context.json and put your AWS account ID in.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
# Red Hat service account for the rhcs Terraform provider; the local "rosa login" wins if present
RHCS_CLIENT_ID=
RHCS_CLIENT_SECRET=
